---
import { vonar } from '../data/vonar';
---

<section class="hero wrap" aria-labelledby="hero-title">
  <p class="eyebrow rise">Free wavetable synth</p>
  <h1 id="hero-title" class="hero-title rise d1">
    Vonar.<span class="muted">Sound first.</span>
  </h1>
  <p class="lead rise d2">
    {`A wavetable synthesizer for FL Studio and other VST3 hosts on Windows. ${vonar.presetCount} presets, ${vonar.effectCount} effects, no cost.`}
  </p>
  <div class="actions rise d3">
    <a class="btn btn--primary" href={vonar.installer.url}>Download for Windows</a>
    <a class="btn btn--secondary" href="#sounds">Hear the presets</a>
  </div>
  <p class="meta rise d3">
    <a href={vonar.changelogPath}>v{vonar.version}</a> · {vonar.format} · {vonar.platform} · {vonar.installer.sizeLabel} installer
  </p>
  <p class="hint rise d3">
    Windows may show a SmartScreen warning — that is expected. <a href={vonar.guidePath}>Installation guide</a>
  </p>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding-top: clamp(40px, 8vw, 72px);
    padding-bottom: 40px;
    text-align: center;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(56px, 9vw, 128px);
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .hero-title .muted {
    display: block;
    color: var(--heading-muted);
  }

  .lead {
    margin: 0;
    max-width: 560px;
    font-size: clamp(18px, 2.2vw, 20px);
    color: var(--text-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }

  .meta {
    margin: 0;
    font-size: 14px;
    color: var(--text-3);
  }

  .hint {
    margin: -12px 0 0;
    font-size: 14px;
    color: var(--text-3);
  }

  .meta a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .hint a {
    color: var(--text);
    font-weight: 600;
    text-underline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(28px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }

    .rise {
      animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .d1 {
      animation-delay: 0.12s;
    }

    .d2 {
      animation-delay: 0.24s;
    }

    .d3 {
      animation-delay: 0.36s;
    }
  }
</style>
