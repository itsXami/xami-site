---
import demos from '../data/vonar-demos.json';

// Categories in the order of Vonar's preset menu; only those with a demo get a filter button.
const order = ['Bass', 'Lead', 'Guitar', 'Pluck', 'Keys', 'Bell', 'Pad', 'Strings', 'Brass', 'Woodwind', 'Arp', 'Drums', 'FX'];
const categories = order.filter((c) => demos.some((d) => d.category === c));
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<section id="sounds" class="sounds wrap section" aria-labelledby="sounds-title">
  <div class="head">
    <p class="eyebrow">Listen</p>
    <h2 id="sounds-title" class="display">Hear it<span class="muted">before you install it.</span></h2>
  </div>

  <div class="filters" role="group" aria-label="Filter by category">
    <button type="button" class="filter" data-filter="all" aria-pressed="true">All</button>
    {
      categories.map((c) => (
        <button type="button" class="filter" data-filter={c} aria-pressed="false">
          {c}
        </button>
      ))
    }
  </div>
  <p class="visually-hidden" aria-live="polite" data-demo-status></p>

  <ul class="demos" data-demos>
    {
      demos.map((d) => (
        <li class="card demo" data-category={d.category}>
          <button
            type="button"
            class="play"
            data-src={d.src}
            data-name={d.name}
            aria-label={`Play ${d.name}`}
            aria-describedby={`demo-${slug(d.name)}`}
          >
            <svg class="icon-play" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M4 2l10 6-10 6z" fill="currentColor" />
            </svg>
            <svg class="icon-stop" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <rect x="3" y="3" width="10" height="10" rx="1" fill="currentColor" />
            </svg>
          </button>
          <div class="info" id={`demo-${slug(d.name)}`}>
            <p class="name">{d.name}</p>
            <p class="cat">{d.category}</p>
          </div>
          <span class="live" aria-hidden="true">
            <span />
            <span />
            <span />
            <span />
            <span />
            <span />
            <span />
          </span>
        </li>
      ))
    }
  </ul>
  <p class="note">Short phrases rendered straight from the plugin, no processing added. MP3, 128 kb/s.</p>
</section>

<script>
  import { initDemos } from '../scripts/demos';
  initDemos();
</script>

<style>
  .sounds {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filter {
    min-height: 44px;
    padding: 10px 18px;
    border: 0;
    border-radius: 999px;
    background: var(--btn-2);
    color: var(--text);
    font: inherit;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .filter[aria-pressed='true'] {
    background: var(--text);
    color: #fff;
  }

  .demos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .demo {
    display: flex;
    align-items: center;
    gap: 18px;
    background: #fff;
    border-radius: 20px;
    padding: 18px 20px;
  }

  .demo[hidden] {
    display: none;
  }

  .play {
    flex: none;
    width: 52px;
    height: 52px;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-stop,
  .is-playing .icon-play {
    display: none;
  }

  .is-playing .icon-stop {
    display: block;
  }

  .info {
    flex: 1 1 auto;
    min-width: 0;
  }

  .name {
    margin: 0;
    font-weight: 600;
    font-size: 17px;
  }

  .cat {
    margin: 2px 0 0;
    font-size: 14px;
    color: var(--text-3);
  }

  .live {
    display: none;
    align-items: flex-end;
    gap: 3px;
    width: 56px;
    height: 28px;
  }

  .is-playing .live {
    display: flex;
  }

  .live span {
    flex: 1;
    height: 100%;
    border-radius: 2px;
    background: var(--accent);
    transform-origin: bottom;
    transform: scaleY(0.6);
  }

  .note {
    margin: 0;
    font-size: 14px;
    color: var(--text-3);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes pulse {
      0%,
      100% {
        box-shadow: 0 0 0 0 rgb(196 87 43 / 45%);
      }
      50% {
        box-shadow: 0 0 0 10px rgb(196 87 43 / 0%);
      }
    }

    @keyframes eq {
      0%,
      100% {
        transform: scaleY(0.25);
      }
      50% {
        transform: scaleY(1);
      }
    }

    .is-playing .play {
      animation: pulse 1.6s ease-out infinite;
    }

    .is-playing .live span {
      animation: eq 1.1s ease-in-out infinite;
    }

    .is-playing .live span:nth-child(2n) {
      animation-duration: 0.8s;
    }

    .is-playing .live span:nth-child(3n) {
      animation-duration: 1.4s;
      animation-delay: -0.3s;
    }
  }
</style>
