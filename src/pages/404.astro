---
import Page from '../layouts/Page.astro';
import { vonar } from '../data/vonar';
---

<Page
  title="Page not found · Xami"
  description="This page does not exist. Go to the home page or download Vonar."
  eyebrow="404"
  heading="Nothing here."
  headingMuted="Wrong turn."
>
  <p>The page you were looking for does not exist or has moved.</p>
  <div class="actions">
    <a class="btn btn--primary" href={vonar.installer.url}>Download Vonar</a>
    <a class="btn btn--secondary" href="/">Go to the home page</a>
  </div>
</Page>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
</style>
