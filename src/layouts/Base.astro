---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Link preview image (1200×630) in public/. */
  ogImage?: string;
}

const { title, description, ogImage = '/og-vonar.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The 404 page is served at any missing URL, so it has no canonical address of its own.
const isNotFound = Astro.url.pathname.replace(/\/$/, '').endsWith('/404');
const image = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F5F3EF" />
    {!isNotFound && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Xami" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!isNotFound && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vonar, a free wavetable synth: the plugin window next to the words Vonar. Sound first." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
