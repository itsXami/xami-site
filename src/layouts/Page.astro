---
// Text page (FAQ, changelog, legal, 404): site header, a narrow column, site footer.
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  headingMuted?: string;
}

const { title, description, eyebrow, heading, headingMuted } = Astro.props;
---

<Base title={title} description={description}>
  <SiteHeader />
  <main id="main" class="page wrap">
    <header class="intro">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="display">{heading}{headingMuted && <span class="muted">{headingMuted}</span>}</h1>
    </header>
    <div class="prose">
      <slot />
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .page {
    max-width: 840px;
    padding-top: clamp(32px, 6vw, 56px);
    padding-bottom: 80px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 40px;
  }

  .prose :global(h2) {
    margin: 40px 0 12px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(24px, 3.2vw, 30px);
    letter-spacing: -0.02em;
    line-height: 1.15;
    scroll-margin-top: 24px;
  }

  .prose :global(h3) {
    margin: 28px 0 8px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 21px;
    letter-spacing: -0.01em;
    line-height: 1.2;
    scroll-margin-top: 24px;
  }

  .prose :global(p),
  .prose :global(li) {
    font-size: 17px;
    color: var(--text-2);
  }

  .prose :global(p) {
    margin: 0 0 14px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 14px;
    padding-left: 22px;
  }

  .prose :global(li + li) {
    margin-top: 6px;
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(a:not(.btn)) {
    color: var(--text);
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .prose :global(code) {
    font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace;
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }

  .prose :global(pre) {
    margin: 0 0 14px;
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--text);
    color: #fff;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .prose :global(.card-block) {
    background: var(--card);
    border-radius: 22px;
    padding: clamp(20px, 3vw, 28px);
    margin-bottom: 14px;
  }

  .prose :global(.card-block > :first-child) {
    margin-top: 0;
  }

  .prose :global(.card-block > :last-child) {
    margin-bottom: 0;
  }
</style>
